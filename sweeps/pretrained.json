{
  "name": "pretrained",
  "seeds": [1],
  "base": {
    "arch": "pretrained",
    "decoder": "unet",
    "encoder": "resnet34",
    "encoder_weights": "imagenet",
    "encoder_lr_scale": 0.25,
    "crop": 512,
    "crops_per_image": 4,
    "foreground_prob": 0.7,
    "pos_weight": 5,
    "batch_size": 8,
    "epochs": 40,
    "lr": 4e-4,
    "warmup_epochs": 3,
    "amp": true,
    "workers": 16,
    "swa_epochs": 12,
    "val_limit": 64,
    "val_tile": 512,
    "val_overlap": 0.0,
    "tile_batch": 8
  },
  "configs": [
    { "name": "unet-resnet34-scratch", "encoder_weights": "none", "encoder_lr_scale": 1.0 },
    { "name": "unet-resnet34-fulllr", "encoder_lr_scale": 1.0 },
    { "name": "unet-effb3", "encoder": "efficientnet-b3" },
    { "name": "unet-convnext_tiny", "encoder": "tu-convnext_tiny" },
    { "name": "unetpp-resnet34", "decoder": "unetplusplus" },
    { "name": "unet-mit_b2", "encoder": "mit_b2" },
    { "name": "unet-regnety_016", "encoder": "tu-regnety_016" }
  ],
  "calibrate": {
    "tile": 512,
    "overlap": 0.25,
    "tile_batch": 8,
    "workers": 8
  }
