{
  "name": "targets",
  "seeds": [1],
  "base": {
    "arch": "pretrained",
    "decoder": "unet",
    "encoder": "resnet34",
    "encoder_weights": "imagenet",
    "encoder_lr_scale": 0.25,
    "crop": 512,
    "crops_per_image": 4,
    "foreground_prob": 0.7,
    "pos_weight": 5,
    "batch_size": 8,
    "epochs": 40,
    "lr": 4e-4,
    "warmup_epochs": 3,
    "amp": true,
    "workers": 12,
    "swa_epochs": 12,
    "val_limit": 64,
    "val_tile": 512,
    "val_overlap": 0.0,
    "tile_batch": 8,
    "raster": "coco"
  },
  "configs": [
    { "name": "coco-each", "targets": "each" },
    { "name": "coco-mean", "targets": "mean", "crops_per_image": 7 }
  ],
  "calibrate": {
    "tile": 512,
    "overlap": 0.25,
    "tile_batch": 8,
    "workers": 8
  }
}
