  "configs": [
    {
      "name": "unetpp-r34-1024-fold0",
      "fold": 0
    },
    {
      "name": "unetpp-r34-1024-fold1",
      "fold": 1
    },
    {
      "name": "unetpp-r34-1024-fold2",
      "fold": 2
    },
    {
      "name": "unetpp-r34-1024-fold3",
      "fold": 3
    },
    {
      "name": "unetpp-r34-1024-fold4",
      "fold": 4
    }
  ],
  "calibrate": {
    "tile": 1024,
    "overlap": 0.25,
    "tile_batch": 2,
    "workers": 8
  }
