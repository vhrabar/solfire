# User service for the long fine-tune queue; it survives logouts (linger) and reboots and restarts after a crash.

[Unit]
Description=Solar filament fine-tune queue
ConditionPathExists=!%h/Programing/SolarFilamentSegmentationChallenge/runs/logs/night_long.done
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h/Programing/SolarFilamentSegmentationChallenge
Environment=PATH=/snap/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Programing/SolarFilamentSegmentationChallenge/scripts/queue.sh night_long finetune_long finetune_long_mitb2 finetune_long_hrnet
StandardOutput=append:%h/Programing/SolarFilamentSegmentationChallenge/runs/logs/night_long.log
StandardError=inherit
Restart=on-failure
RestartSec=120
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
